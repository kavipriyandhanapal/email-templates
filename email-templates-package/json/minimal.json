      "body": "<body style=\"margin:0;padding:0;background:#ffffff;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#ffffff;padding:36px 18px\"><tr><td align=\"center\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;\"><tr><td style=\"padding:8px 0 0 22px;border-left:4px solid #d97706\"><img src=\"{logoUrl}\" alt=\"{organizationName}\" height=\"56\" style=\"display:block;height:56px;width:auto;max-width:180px;border:0;outline:none;margin:0 0 18px\"><div style=\"color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1px\">{organizationName} · {appName}</div><h1 style=\"margin:10px 0 10px;color:#0f172a;font-size:22px\">Leave request sent back</h1><p style=\"margin:0 0 18px;color:#475569;font-size:15px;line-height:1.65\">Hello <strong>{receiverName}</strong>, your leave request was returned for changes. Update it and submit it again.</p><div style=\"margin:7px 0;font-size:14px;color:#0f172a;line-height:1.5\"><span style=\"display:inline-block;min-width:92px;color:#64748b\">Request</span>{requestId}</div><div style=\"margin:7px 0;font-size:14px;color:#0f172a;line-height:1.5\"><span style=\"display:inline-block;min-width:92px;color:#64748b\">Leave</span>{leaveType}, {startDate} – {endDate} ({days} day(s))</div><div style=\"margin:7px 0;font-size:14px;color:#0f172a;line-height:1.5\"><span style=\"display:inline-block;min-width:92px;color:#64748b\">Supervisor</span>{supervisorName}</div><div style=\"margin:7px 0;font-size:14px;color:#0f172a;line-height:1.5\"><span style=\"display:inline-block;min-width:92px;color:#64748b\">Reason</span>{reason}</div><div style=\"margin:24px 0 8px\"><a href=\"{appUrl}\" style=\"display:inline-block;text-decoration:none;font-weight:700;color:#d97706;font-size:15px;text-decoration:underline\">View leave request →</a></div></td></tr><tr><td style=\"padding:28px 0 0;color:#94a3b8;font-size:12px\">This is an automated Timesheet notification.</td></tr></table></td></tr></table></body>"
