{
  "theme": "banner",
  "templates": {
    "submitted": {
      "subject": "Leave request {requestId} awaiting your approval",
      "body": "<body style=\"margin:0;padding:0;background:#eef2f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#eef2f7;padding:36px 18px\"><tr><td align=\"center\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:620px;background:#fff;border-radius:14px;overflow:hidden\"><tr><td style=\"padding:32px 38px;background-color:#2563eb;background-image:linear-gradient(120deg,#2563eb 0%,#0f172a 230%)\"><div style=\"margin-bottom:18px\"><span style=\"display:inline-block;background:#fff;border-radius:10px;padding:7px 12px\"><img src=\"{logoUrl}\" alt=\"{organizationName}\" height=\"56\" style=\"display:block;height:56px;width:auto;max-width:180px;border:0;outline:none;\"></span></div><div style=\"color:rgba(255,255,255,.78);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1px\">{organizationName} · {appName}</div><h1 style=\"margin:12px 0 0;color:#fff;font-size:27px\">New leave request</h1></td></tr><tr><td style=\"padding:28px 38px 8px\"><p style=\"margin:0 0 18px;color:#475569;font-size:16px;line-height:1.6\"><strong>{employeeName}</strong> submitted a leave request that needs your review.</p><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Request</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{requestId}</td></tr><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Employee</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{employeeName}</td></tr><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Leave</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{leaveType}, {startDate} – {endDate} ({days} day(s))</td></tr><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Reason</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{reason}</td></tr></table></td></tr><tr><td style=\"padding:24px 38px 34px\"><a href=\"{appUrl}\" style=\"display:inline-block;text-decoration:none;font-weight:700;background:#2563eb;color:#fff;padding:14px 30px;border-radius:99px\">Review request</a></td></tr><tr><td style=\"padding:18px 38px;background:#f8fafc;color:#94a3b8;font-size:12px;text-align:center\">This is an automated Timesheet notification.</td></tr></table></td></tr></table></body>"
    },
    "approved": {
      "subject": "Leave request {requestId} approved",
      "body": "<body style=\"margin:0;padding:0;background:#eef2f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#eef2f7;padding:36px 18px\"><tr><td align=\"center\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:620px;background:#fff;border-radius:14px;overflow:hidden\"><tr><td style=\"padding:32px 38px;background-color:#16a34a;background-image:linear-gradient(120deg,#16a34a 0%,#0f172a 230%)\"><div style=\"margin-bottom:18px\"><span style=\"display:inline-block;background:#fff;border-radius:10px;padding:7px 12px\"><img src=\"{logoUrl}\" alt=\"{organizationName}\" height=\"56\" style=\"display:block;height:56px;width:auto;max-width:180px;border:0;outline:none;\"></span></div><div style=\"color:rgba(255,255,255,.78);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1px\">{organizationName} · {appName}</div><h1 style=\"margin:12px 0 0;color:#fff;font-size:27px\">Leave request approved</h1></td></tr><tr><td style=\"padding:28px 38px 8px\"><p style=\"margin:0 0 18px;color:#475569;font-size:16px;line-height:1.6\">Hello <strong>{receiverName}</strong>, your leave request has been approved.</p><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Request</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{requestId}</td></tr><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Leave</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{leaveType}, {startDate} – {endDate} ({days} day(s))</td></tr><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Approved by</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{supervisorName}</td></tr></table></td></tr><tr><td style=\"padding:24px 38px 34px\"><a href=\"{appUrl}\" style=\"display:inline-block;text-decoration:none;font-weight:700;background:#16a34a;color:#fff;padding:14px 30px;border-radius:99px\">View leave request</a></td></tr><tr><td style=\"padding:18px 38px;background:#f8fafc;color:#94a3b8;font-size:12px;text-align:center\">This is an automated Timesheet notification.</td></tr></table></td></tr></table></body>"
    },
    "rejected": {
      "subject": "Leave request {requestId} rejected",
      "body": "<body style=\"margin:0;padding:0;background:#eef2f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#eef2f7;padding:36px 18px\"><tr><td align=\"center\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:620px;background:#fff;border-radius:14px;overflow:hidden\"><tr><td style=\"padding:32px 38px;background-color:#dc2626;background-image:linear-gradient(120deg,#dc2626 0%,#0f172a 230%)\"><div style=\"margin-bottom:18px\"><span style=\"display:inline-block;background:#fff;border-radius:10px;padding:7px 12px\"><img src=\"{logoUrl}\" alt=\"{organizationName}\" height=\"56\" style=\"display:block;height:56px;width:auto;max-width:180px;border:0;outline:none;\"></span></div><div style=\"color:rgba(255,255,255,.78);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1px\">{organizationName} · {appName}</div><h1 style=\"margin:12px 0 0;color:#fff;font-size:27px\">Leave request rejected</h1></td></tr><tr><td style=\"padding:28px 38px 8px\"><p style=\"margin:0 0 18px;color:#475569;font-size:16px;line-height:1.6\">Hello <strong>{receiverName}</strong>, unfortunately your leave request was not approved.</p><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Request</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{requestId}</td></tr><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Leave</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{leaveType}, {startDate} – {endDate} ({days} day(s))</td></tr><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Rejected by</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{supervisorName}</td></tr><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Reason</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{reason}</td></tr></table></td></tr><tr><td style=\"padding:24px 38px 34px\"><a href=\"{appUrl}\" style=\"display:inline-block;text-decoration:none;font-weight:700;background:#dc2626;color:#fff;padding:14px 30px;border-radius:99px\">View leave request</a></td></tr><tr><td style=\"padding:18px 38px;background:#f8fafc;color:#94a3b8;font-size:12px;text-align:center\">This is an automated Timesheet notification.</td></tr></table></td></tr></table></body>"
    },
    "sendBack": {
      "subject": "Leave request {requestId} sent back",
      "body": "<body style=\"margin:0;padding:0;background:#eef2f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#eef2f7;padding:36px 18px\"><tr><td align=\"center\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:620px;background:#fff;border-radius:14px;overflow:hidden\"><tr><td style=\"padding:32px 38px;background-color:#d97706;background-image:linear-gradient(120deg,#d97706 0%,#0f172a 230%)\"><div style=\"margin-bottom:18px\"><span style=\"display:inline-block;background:#fff;border-radius:10px;padding:7px 12px\"><img src=\"{logoUrl}\" alt=\"{organizationName}\" height=\"56\" style=\"display:block;height:56px;width:auto;max-width:180px;border:0;outline:none;\"></span></div><div style=\"color:rgba(255,255,255,.78);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1px\">{organizationName} · {appName}</div><h1 style=\"margin:12px 0 0;color:#fff;font-size:27px\">Leave request sent back</h1></td></tr><tr><td style=\"padding:28px 38px 8px\"><p style=\"margin:0 0 18px;color:#475569;font-size:16px;line-height:1.6\">Hello <strong>{receiverName}</strong>, your leave request was returned for changes. Update it and submit it again.</p><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Request</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{requestId}</td></tr><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Leave</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{leaveType}, {startDate} – {endDate} ({days} day(s))</td></tr><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Supervisor</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{supervisorName}</td></tr><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Reason</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{reason}</td></tr></table></td></tr><tr><td style=\"padding:24px 38px 34px\"><a href=\"{appUrl}\" style=\"display:inline-block;text-decoration:none;font-weight:700;background:#d97706;color:#fff;padding:14px 30px;border-radius:99px\">View leave request</a></td></tr><tr><td style=\"padding:18px 38px;background:#f8fafc;color:#94a3b8;font-size:12px;text-align:center\">This is an automated Timesheet notification.</td></tr></table></td></tr></table></body>"
    },
    "cancelled": {
      "subject": "Leave request {requestId} cancelled",
      "body": "<body style=\"margin:0;padding:0;background:#eef2f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#eef2f7;padding:36px 18px\"><tr><td align=\"center\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:620px;background:#fff;border-radius:14px;overflow:hidden\"><tr><td style=\"padding:32px 38px;background-color:#475569;background-image:linear-gradient(120deg,#475569 0%,#0f172a 230%)\"><div style=\"margin-bottom:18px\"><span style=\"display:inline-block;background:#fff;border-radius:10px;padding:7px 12px\"><img src=\"{logoUrl}\" alt=\"{organizationName}\" height=\"56\" style=\"display:block;height:56px;width:auto;max-width:180px;border:0;outline:none;\"></span></div><div style=\"color:rgba(255,255,255,.78);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1px\">{organizationName} · {appName}</div><h1 style=\"margin:12px 0 0;color:#fff;font-size:27px\">Leave request cancelled</h1></td></tr><tr><td style=\"padding:28px 38px 8px\"><p style=\"margin:0 0 18px;color:#475569;font-size:16px;line-height:1.6\">Hello <strong>{receiverName}</strong>, the leave request below has been cancelled.</p><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Request</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{requestId}</td></tr><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Leave</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{leaveType}, {startDate} – {endDate} ({days} day(s))</td></tr><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Cancelled by</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{supervisorName}</td></tr></table></td></tr><tr><td style=\"padding:24px 38px 34px\"><a href=\"{appUrl}\" style=\"display:inline-block;text-decoration:none;font-weight:700;background:#475569;color:#fff;padding:14px 30px;border-radius:99px\">View leave request</a></td></tr><tr><td style=\"padding:18px 38px;background:#f8fafc;color:#94a3b8;font-size:12px;text-align:center\">This is an automated Timesheet notification.</td></tr></table></td></tr></table></body>"
    },
    "reminder": {
      "subject": "Reminder: leave request {requestId} is still pending",
      "body": "<body style=\"margin:0;padding:0;background:#eef2f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#eef2f7;padding:36px 18px\"><tr><td align=\"center\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:620px;background:#fff;border-radius:14px;overflow:hidden\"><tr><td style=\"padding:32px 38px;background-color:#ea580c;background-image:linear-gradient(120deg,#ea580c 0%,#0f172a 230%)\"><div style=\"margin-bottom:18px\"><span style=\"display:inline-block;background:#fff;border-radius:10px;padding:7px 12px\"><img src=\"{logoUrl}\" alt=\"{organizationName}\" height=\"56\" style=\"display:block;height:56px;width:auto;max-width:180px;border:0;outline:none;\"></span></div><div style=\"color:rgba(255,255,255,.78);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1px\">{organizationName} · {appName}</div><h1 style=\"margin:12px 0 0;color:#fff;font-size:27px\">Approval reminder</h1></td></tr><tr><td style=\"padding:28px 38px 8px\"><p style=\"margin:0 0 18px;color:#475569;font-size:16px;line-height:1.6\">Hello <strong>{receiverName}</strong>, this request from <strong>{employeeName}</strong> is still waiting for your decision.</p><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Request</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{requestId}</td></tr><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Employee</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{employeeName}</td></tr><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Leave</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{leaveType}, {startDate} – {endDate} ({days} day(s))</td></tr></table></td></tr><tr><td style=\"padding:24px 38px 34px\"><a href=\"{appUrl}\" style=\"display:inline-block;text-decoration:none;font-weight:700;background:#ea580c;color:#fff;padding:14px 30px;border-radius:99px\">Review request</a></td></tr><tr><td style=\"padding:18px 38px;background:#f8fafc;color:#94a3b8;font-size:12px;text-align:center\">This is an automated Timesheet notification.</td></tr></table></td></tr></table></body>"
    },
    "overtimeApproved": {
      "subject": "Overtime request {requestId} approved",
      "body": "<body style=\"margin:0;padding:0;background:#eef2f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#eef2f7;padding:36px 18px\"><tr><td align=\"center\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:620px;background:#fff;border-radius:14px;overflow:hidden\"><tr><td style=\"padding:32px 38px;background-color:#7c3aed;background-image:linear-gradient(120deg,#7c3aed 0%,#0f172a 230%)\"><div style=\"margin-bottom:18px\"><span style=\"display:inline-block;background:#fff;border-radius:10px;padding:7px 12px\"><img src=\"{logoUrl}\" alt=\"{organizationName}\" height=\"56\" style=\"display:block;height:56px;width:auto;max-width:180px;border:0;outline:none;\"></span></div><div style=\"color:rgba(255,255,255,.78);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1px\">{organizationName} · {appName}</div><h1 style=\"margin:12px 0 0;color:#fff;font-size:27px\">Overtime approved</h1></td></tr><tr><td style=\"padding:28px 38px 8px\"><p style=\"margin:0 0 18px;color:#475569;font-size:16px;line-height:1.6\">Hello <strong>{receiverName}</strong>, your overtime request was approved. You can now use the pay code on your timesheet.</p><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Request</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{requestId}</td></tr><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Work date</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{workDate}</td></tr><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Pay code</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{payCode}</td></tr><tr><td style=\"padding:12px 0;color:#94a3b8;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;border-bottom:1px solid #eef2f7\">Hours</td><td style=\"padding:12px 0;text-align:right;color:#0f172a;font-size:15px;border-bottom:1px solid #eef2f7\">{hours}</td></tr></table></td></tr><tr><td style=\"padding:24px 38px 34px\"><a href=\"{appUrl}\" style=\"display:inline-block;text-decoration:none;font-weight:700;background:#7c3aed;color:#fff;padding:14px 30px;border-radius:99px\">Open timesheet</a></td></tr><tr><td style=\"padding:18px 38px;background:#f8fafc;color:#94a3b8;font-size:12px;text-align:center\">This is an automated Timesheet notification.</td></tr></table></td></tr></table></body>"
    },
