      "body": "<body style=\"margin:0;padding:0;background:#f4f7fb;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f4f7fb;padding:36px 18px\"><tr><td align=\"center\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:620px;background:#fff;border:1px solid #e2e8f0;border-radius:16px;overflow:hidden\"><tr><td style=\"height:5px;background:#ea580c\"></td></tr><tr><td style=\"padding:34px 38px 14px\"><img src=\"{logoUrl}\" alt=\"{organizationName}\" height=\"56\" style=\"display:block;height:56px;width:auto;max-width:180px;border:0;outline:none;margin:0 0 20px\"><div style=\"color:#64748b;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.8px\">{organizationName} · {appName}</div><h1 style=\"margin:14px 0 8px;color:#0f172a;font-size:25px\">Approval reminder</h1><p style=\"margin:0;color:#475569;font-size:16px;line-height:1.6\">Hello <strong>{receiverName}</strong>, this request from <strong>{employeeName}</strong> is still waiting for your decision.</p></td></tr><tr><td style=\"padding:14px 38px 8px\"><table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px\"><tr><td style=\"padding:12px 16px;color:#64748b;font-size:13px\">Request</td><td style=\"padding:12px 16px;text-align:right;color:#0f172a;font-weight:700\">{requestId}</td></tr><tr><td style=\"padding:12px 16px;color:#64748b;font-size:13px;border-top:1px solid #e2e8f0\">Employee</td><td style=\"padding:12px 16px;text-align:right;color:#0f172a;border-top:1px solid #e2e8f0\">{employeeName}</td></tr><tr><td style=\"padding:12px 16px;color:#64748b;font-size:13px;border-top:1px solid #e2e8f0\">Leave</td><td style=\"padding:12px 16px;text-align:right;color:#0f172a;border-top:1px solid #e2e8f0\">{leaveType}, {startDate} – {endDate} ({days} day(s))</td></tr></table></td></tr><tr><td sty